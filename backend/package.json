{
  "name": "brew-and-bind-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Brew & Bind backend: Express API and PostgreSQL",
  "scripts": {
    "dev": "node --watch-path=src --watch-preserve-output src/index.js",
    "start": "node src/index.js",
    "db:local": "node scripts/local-db.js",
    "db:init": "node src/db/init.js",
    "test:api": "node scripts/api-test.mjs",
    "db:seed-books": "node scripts/seed-books.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
