# Copy this file to .env and adjust if needed.

# Where the API listens
PORT=4000

# PostgreSQL connection. The default matches the local database started by "npm run db:local".
# For your own PostgreSQL server use something like: postgres://USER:PASSWORD@localhost:5432/library
DATABASE_URL=postgres://postgres:postgres@localhost:5433/library

# Secret used to sign login tokens. Change it for anything beyond local development.
JWT_SECRET=change-me-to-a-long-random-string

# Staff code that librarians and admins enter when they sign in (as well as
# their membership ID and password). Share it only with library staff.
STAFF_SIGNIN_CODE=SHELF-STAFF
